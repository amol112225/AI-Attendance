# AttendAI Frontend - Environment Configuration Example
# Vite exposes variables prefixed with VITE_ to client-side code.
# NEVER store secrets, private tokens, or service-role keys in this file or any frontend code.

# Backend API Base URL (FastAPI) - Future Integration
VITE_API_BASE_URL=http://localhost:8000/api

# Supabase Public Configuration (Supabase Auth & Database) - Future Integration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

